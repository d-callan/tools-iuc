<macros>
    <token name="@TOOL_VERSION@">0.1.2</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">24.1</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">rhizaeon</requirement>
        </requirements>
    </xml>
    <xml name="version_command">
        <version_command><![CDATA[rhizaeon --version | sed 's/^rhizaeon[[:space:]]*//']]></version_command>
    </xml>
    <xml name="citations">
        <citations>
            <!--
                The 10.64898 prefix is openRxiv's (bioRxiv/medRxiv moved off
                10.1101), so it is not a typo. Verified against Crossref: this
                DOI resolves to "Clean Breaks: Attention Force Field
                Deconvolution of Recombination Across Sequence Manifolds"
                (Kosakovsky Pond et al., bioRxiv 2026), which is the RhizAeon
                preprint.
            -->
            <citation type="doi">10.64898/2026.10.19.760237</citation>
        </citations>
    </xml>
    <!-- The engine is single-threaded and upstream exposes no thread flag,
         so no GALAXY_SLOTS token is defined here on purpose. -->
</macros>
