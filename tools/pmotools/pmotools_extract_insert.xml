<tool id="pmotools_extract_insert" name="pmotools extract_insert" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>Extract insert sequences or reference sequences of panel targets from a PMO</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="bio_tools"/>
    <expand macro="requirements"/>
    <expand macro="version_command"/>
    <expand macro="stdio"/>
    <command detect_errors="aggressive"><![CDATA[
pmotools-python $insert_mode.subcommand
  --file '$input_pmo'
  --output '$output_table'
  @OVERWRITE@
#if $insert_mode.subcommand == "extract_insert_of_panels" and $insert_mode.add_ref_seqs:
  --add_ref_seqs
#end if
    ]]></command>
    <inputs>
        <expand macro="input_pmo"/>
        <conditional name="insert_mode">
            <param name="subcommand" type="select" label="Extraction mode">
                <option value="extract_insert_of_panels" selected="true">Extract insert locations of panels (BED-like)</option>
                <option value="extract_refseq_of_inserts_of_panels">Extract reference sequences of panel inserts</option>
            </param>
            <when value="extract_insert_of_panels">
                <param name="add_ref_seqs" type="boolean" truevalue="--add_ref_seqs" falsevalue="" checked="false" label="Add reference sequences to output" help="Include the ref_seq column in the output"/>
            </when>
            <when value="extract_refseq_of_inserts_of_panels"/>
        </conditional>
    </inputs>
    <outputs>
        <data name="output_table" format="tabular" label="${insert_mode.subcommand} of ${tool.name} on ${on_string}"/>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="input_pmo" ftype="json" value="minimum_pmo_example.json"/>
            <conditional name="insert_mode">
                <param name="subcommand" value="extract_insert_of_panels"/>
                <param name="add_ref_seqs" value="false"/>
            </conditional>
            <output name="output_table">
                <assert_contents>
                    <has_text text="#chrom"/>
                    <has_text text="target_id"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="input_pmo" ftype="json" value="minimum_pmo_example.json"/>
            <conditional name="insert_mode">
                <param name="subcommand" value="extract_refseq_of_inserts_of_panels"/>
            </conditional>
            <output name="output_table">
                <assert_contents>
                    <has_text text="target_id"/>
                    <has_text text="ref_seq"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[
@HELP_PREAMBLE@

**Extract Insert Information from PMO**

Extracts insert-related information from a PMO file:

- **Extract insert locations of panels**: Produces a BED-like tabular file with columns: chrom, start, end, target_id, length, strand, extra_info. Optionally includes a ref_seq column.
- **Extract reference sequences of panel inserts**: Produces a tabular file with columns: target_id, ref_seq. If no reference sequence is stored in the PMO, the ref_seq field will be blank.

**Input**

- A PMO JSON file (optionally gzipped)

**Output**

- A tabular file with insert location or reference sequence information
    ]]></help>
    <expand macro="citations"/>
</tool>
